# Intervals.icu API Credentials
# Get these from https://intervals.icu/settings

# Your API key (found in Developer section of settings)
INTERVALS_ICU_API_KEY=your_api_key_here

# Your athlete ID (format: i123456, found in your profile URL)
INTERVALS_ICU_ATHLETE_ID=i123456

# Optional: include `fetched_at` + `query_type` in every response's metadata
# block. Off by default to keep responses compact; enable for debugging.
# INTERVALS_ICU_DEBUG_METADATA=false

# Fork-specific, not part of upstream: enables the hevy_* tools (Hevy is a
# separate strength-training logging app). Get a key from the Hevy app:
# Settings > API. Leave unset if you don't use Hevy.
# HEVY_API_KEY=your_hevy_api_key_here
